build/USA/*
!build/USA/assets/
build/USA/assets/*
!build/USA/assets/map_offsets.h
!build/USA/assets/gfx_offsets.h
# Same two headers for the EU baseline (issue #3). They are symbol -> blob-offset
# tables generated by `asset_processor extract EU` — no ROM bytes — and without
# them in the tree `--game_version=EU` cannot compile on a fresh checkout, which
# is why no EU build existed. Tracked so EU is buildable with nothing but the
# documented xmake commands, exactly like USA.
!build/EU/
build/EU/*
!build/EU/assets/
build/EU/assets/*
!build/EU/assets/map_offsets.h
!build/EU/assets/gfx_offsets.h
